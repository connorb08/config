{
  "name": "One Monokai Darker",
  "type": "dark",
  "colors": {
    "activityBar.background": "{{ bg_activity }}",
    "activityBar.foreground": "{{ fg_bright }}",
    "activityBarBadge.background": "{{ blue_ansi }}",
    "activityBarBadge.foreground": "{{ badge_fg }}",
    "button.background": "{{ blue_ansi }}",
    "debugToolBar.background": "{{ bg_activity }}",
    "diffEditor.insertedTextBackground": "{{ teal }}33",
    "dropdown.background": "{{ bg_input }}",
    "dropdown.border": "{{ bg_darkest }}",
    "editor.background": "{{ bg }}",
    "editor.findMatchBackground": "{{ search }}",
    "editor.findMatchHighlightBackground": "{{ search_other }}",
    "editor.lineHighlightBackground": "{{ line }}",
    "editor.selectionBackground": "{{ selection }}",
    "editorCursor.foreground": "{{ cursor }}",
    "editorError.foreground": "{{ red_dark }}",
    "editorGroup.emptyBackground": "{{ bg_darkest }}",
    "editorGroup.border": "{{ bg_darkest }}",
    "editorGroupHeader.tabsBackground": "{{ bg_dark }}",
    "editorIndentGuide.background": "{{ border }}",
    "editorHoverWidget.background": "{{ bg_dark }}",
    "editorHoverWidget.border": "{{ bg_darkest }}",
    "editorLineNumber.foreground": "{{ gutter }}",
    "editorRuler.foreground": "{{ ruler }}",
    "editorSuggestWidget.background": "{{ bg_dark }}",
    "editorSuggestWidget.border": "{{ bg_darkest }}",
    "editorSuggestWidget.selectedBackground": "{{ hover }}",
    "editorUnnecessaryCode.opacity": "{{ true_black }}c0",
    "editorWhitespace.foreground": "{{ whitespace }}",
    "editorWidget.background": "{{ bg_dark }}",
    "input.background": "{{ bg_input }}",
    "list.activeSelectionBackground": "{{ hover }}",
    "list.activeSelectionForeground": "{{ fg_bright }}",
    "list.focusBackground": "{{ line }}",
    "list.highlightForeground": "{{ list_highlight }}",
    "list.hoverBackground": "{{ list_hover }}",
    "list.inactiveSelectionBackground": "{{ hover }}",
    "list.inactiveSelectionForeground": "{{ fg_bright }}",
    "notifications.background": "{{ bg_dark }}",
    "scrollbarSlider.activeBackground": "{{ scrollbar_active }}80",
    "scrollbarSlider.background": "{{ scrollbar }}80",
    "scrollbarSlider.hoverBackground": "{{ scrollbar_hover }}80",
    "sideBar.background": "{{ bg_dark }}",
    "sideBarSectionHeader.background": "{{ bg }}",
    "statusBar.background": "{{ bg_dark }}",
    "statusBar.foreground": "{{ fg_dim }}",
    "statusBarItem.hoverBackground": "{{ hover }}",
    "statusBar.noFolderBackground": "{{ bg_dark }}",
    "statusBar.debuggingBackground": "{{ bg_dark }}",
    "tab.activeBackground": "{{ line }}",
    "tab.border": "{{ bg_darkest }}",
    "tab.inactiveBackground": "{{ bg_dark }}",
    "terminal.foreground": "{{ fg }}",
    "terminal.ansiBlack": "{{ black }}",
    "terminal.ansiBlue": "{{ blue_ansi }}",
    "terminal.ansiGreen": "{{ green }}",
    "terminal.ansiYellow": "{{ yellow }}",
    "terminal.ansiCyan": "{{ cyan }}",
    "terminal.ansiMagenta": "{{ purple }}",
    "terminal.ansiRed": "{{ red }}",
    "terminal.ansiWhite": "{{ fg_bright }}",
    "terminal.ansiBrightBlack": "{{ grey }}",
    "terminal.ansiBrightBlue": "{{ blue_ansi }}",
    "terminal.ansiBrightGreen": "{{ green }}",
    "terminal.ansiBrightYellow": "{{ yellow }}",
    "terminal.ansiBrightCyan": "{{ cyan }}",
    "terminal.ansiBrightMagenta": "{{ purple_dark }}",
    "terminal.ansiBrightRed": "{{ red_bright }}",
    "terminal.ansiBrightWhite": "{{ fg_bright }}",
    "titleBar.activeBackground": "{{ bg }}",
    "titleBar.activeForeground": "{{ fg_dim }}",
    "titleBar.inactiveBackground": "{{ bg }}",
    "titleBar.inactiveForeground": "{{ title_inactive }}"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "{{ comment }}"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.template"
      ],
      "settings": {
        "foreground": "{{ yellow }}"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "{{ purple }}"
      }
    },
    {
      "name": "Embedded String Begin/End",
      "scope": [
        "string.embedded.begin",
        "string.embedded.end",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "{{ purple }}"
      }
    },
    {
      "name": "Default Embedded Color",
      "scope": [
        "punctuation.section.embedded.begin.js",
        "punctuation.section.embedded.end.js",
        "punctuation.section.embedded.begin.erb",
        "punctuation.section.embedded.end.erb",
        "source.elixir.embedded",
        "punctuation.separator",
        "punctuation.accessor",
        "meta.brace"
      ],
      "settings": {
        "foreground": "{{ fg }}"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "foreground": "{{ cyan }}"
      }
    },
    {
      "name": "User-defined constant",
      "scope": [
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "{{ cyan }}"
      }
    },
    {
      "name": "Language Variable",
      "scope": "variable.language",
      "settings": {
        "foreground": "{{ red }}"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.operator.logical",
        "keyword.operator.constructor"
      ],
      "settings": {
        "foreground": "{{ red }}"
      }
    },
    {
      "name": "Keyword Operator",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "{{ red }}"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "foreground": "{{ red }}"
      }
    },
    {
      "name": "Types",
      "scope": "storage.type",
      "settings": {
        "foreground": "{{ cyan }}"
      }
    },
    {
      "name": "Class",
      "scope": [
        "entity.name.class",
        "entity.name.module",
        "entity.name.type",
        "storage.identifier",
        "support.class"
      ],
      "settings": {
        "foreground": "{{ blue }}"
      }
    },
    {
      "name": "Variable Object",
      "scope": [
        "variable.other.object",
        "variable.other.constant",
        "variable.other.global",
        "variable.other.readwrite.class",
        "variable.other.readwrite.instance",
        "variable.other.readwrite.batchfile",
        "variable.readwrite",
        "variable.readwrite.other.block"
      ],
      "settings": {
        "foreground": "{{ blue }}"
      }
    },
    {
      "name": "Other variable",
      "scope": [
        "variable.other",
        "variable.other.property",
        "variable.other.block"
      ],
      "settings": {
        "foreground": "{{ fg }}"
      }
    },
    {
      "name": "Inherited Class",
      "scope": "entity.other.inherited-class",
      "settings": {
        "foreground": "{{ green }}"
      }
    },
    {
      "name": "Package Import",
      "scope": [
        "storage.modifier.import",
        "storage.modifier.package"
      ],
      "settings": {
        "foreground": "{{ blue }}"
      }
    },
    {
      "name": "Function name",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "{{ green }}"
      }
    },
    {
      "name": "Function argument",
      "scope": [
        "variable.parameter",
        "entity.name.variable.parameter",
        "parameter.variable"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "{{ orange }}"
      }
    },
    {
      "name": "Function call",
      "scope": "entity.name.function-call",
      "settings": {
        "foreground": "{{ fg }}"
      }
    },
    {
      "name": "Builtin Functions",
      "scope": [
        "function.support.builtin",
        "function.support.core"
      ],
      "settings": {
        "foreground": "{{ green }}"
      }
    },
    {
      "name": "Tag Name",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.class.js"
      ],
      "settings": {
        "foreground": "{{ red }}"
      }
    },
    {
      "name": "Tag Class and ID",
      "scope": [
        "entity.name.tag.class",
        "entity.name.tag.id"
      ],
      "settings": {
        "foreground": "{{ cyan }}"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "{{ green }}"
      }
    },
    {
      "name": "Library constant",
      "scope": "support.constant",
      "settings": {
        "foreground": "{{ cyan }}"
      }
    },
    {
      "name": "Library class/type",
      "scope": [
        "support.type",
        "support.variable"
      ],
      "settings": {
        "foreground": "{{ cyan }}"
      }
    },
    {
      "name": "Json Property",
      "scope": "support.dictionary.json",
      "settings": {
        "foreground": "{{ cyan }}"
      }
    },
    {
      "name": "StyleSheet Property name",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less",
        "support.type.property-name.sass"
      ],
      "settings": {
        "foreground": "{{ fg }}"
      }
    },
    {
      "name": "CSS: Pseudo Attribute Names",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-class.scss",
        "entity.other.attribute-name.pseudo-class.less",
        "entity.other.attribute-name.pseudo-class.sass",
        "entity.other.attribute-name.pseudo-element.css",
        "entity.other.attribute-name.pseudo-element.scss",
        "entity.other.attribute-name.pseudo-element.less",
        "entity.other.attribute-name.pseudo-element.sass"
      ],
      "settings": {
        "foreground": "{{ cyan }}"
      }
    },
    {
      "name": "StyleSheet Property value",
      "scope": [
        "support.constant.css",
        "support.constant.scss",
        "support.constant.less",
        "support.constant.sass"
      ],
      "settings": {
        "foreground": "{{ green }}"
      }
    },
    {
      "name": "StyleSheet Variable",
      "scope": [
        "variable.css",
        "variable.scss",
        "variable.less",
        "variable.sass"
      ],
      "settings": {
        "foreground": "{{ cyan }}"
      }
    },
    {
      "name": "StyleSheet Variable String",
      "scope": [
        "variable.css.string",
        "variable.scss.string",
        "variable.less.string",
        "variable.sass.string"
      ],
      "settings": {
        "foreground": "{{ yellow }}"
      }
    },
    {
      "name": "StyleSheet Unit",
      "scope": [
        "unit.css",
        "unit.scss",
        "unit.less",
        "unit.sass"
      ],
      "settings": {
        "foreground": "{{ purple }}"
      }
    },
    {
      "name": "StyleSheet Function",
      "scope": [
        "function.css",
        "function.scss",
        "function.less",
        "function.sass"
      ],
      "settings": {
        "foreground": "{{ cyan }}"
      }
    },
    {
      "name": "Library variable",
      "scope": "support.other.variable",
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "background": "{{ invalid }}",
        "foreground": "{{ cursor }}"
      }
    },
    {
      "name": "Invalid deprecated",
      "scope": "invalid.deprecated",
      "settings": {
        "background": "{{ invalid_deprecated }}",
        "foreground": "{{ cursor }}"
      }
    },
    {
      "name": "JSON String",
      "scope": "support.type.property-name.json",
      "settings": {
        "foreground": "{{ cyan }}"
      }
    },
    {
      "name": "Link",
      "scope": "string.detected-link",
      "settings": {
        "foreground": "{{ blue }}"
      }
    },
    {
      "name": "diff.header",
      "scope": [
        "meta.diff",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "{{ diff_header }}"
      }
    },
    {
      "name": "diff.deleted",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "{{ red }}"
      }
    },
    {
      "name": "diff.inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "{{ green }}"
      }
    },
    {
      "name": "diff.changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "{{ yellow }}"
      }
    },
    {
      "scope": "constant.numeric.line-number.find-in-files - match",
      "settings": {
        "foreground": "{{ cyan }}A0"
      }
    },
    {
      "scope": "entity.name.filename.find-in-files",
      "settings": {
        "foreground": "{{ yellow }}"
      }
    },
    {
      "name": "Markup: Emphasis",
      "scope": "markup.italic, markup.italic.markdown",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup: Punctuation",
      "scope": [
        "punctuation.definition.italic.markdown",
        "punctuation.definition.bold.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "{{ comment }}"
      }
    },
    {
      "name": "Markup: Emphasis Punctuation",
      "scope": "punctuation.definition.italic.markdown",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: Link",
      "scope": "markup.underline.link.markdown",
      "settings": {
        "foreground": "{{ blue }}"
      }
    },
    {
      "name": "Markup: Bold",
      "scope": "markup.bold.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup: Heading",
      "scope": "markup.heading.markdown",
      "settings": {
        "fontStyle": "bold",
        "foreground": "{{ red }}"
      }
    },
    {
      "name": "Markup: Quote",
      "scope": "markup.quote.markdown",
      "settings": {
        "foreground": "{{ green }}"
      }
    },
    {
      "name": "Markup: Separator",
      "scope": "meta.separator.markdown",
      "settings": {
        "foreground": "{{ purple }}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup: Raw",
      "scope": [
        "markup.inline.raw",
        "markup.raw.block.markdown"
      ],
      "settings": {
        "foreground": "{{ cyan }}"
      }
    },
    {
      "name": "Markup: List Punctuation",
      "scope": "punctuation.definition.list_item.markdown",
      "settings": {
        "fontStyle": "bold",
        "foreground": "{{ white }}"
      }
    }
  ]
}
