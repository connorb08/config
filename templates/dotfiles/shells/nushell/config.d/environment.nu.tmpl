$env.config.buffer_editor = "nvim"
$env.config.show_banner = false

# Integrations are generated separately into $nu.data-dir/vendor/autoload.
use std/util "path add"
path add ($nu.home-dir | path join ".local" "bin")
if ("/opt/homebrew/bin" | path exists) { path add "/opt/homebrew/bin" }

if $nu.os-info.name != "windows" and ($env.XDG_CONFIG_HOME? | is-empty) {
    $env.XDG_CONFIG_HOME = ($nu.home-dir | path join ".config")
}
$env.EDITOR = "nvim"
$env.VISUAL = "nvim"
# Silences macOS bash's "default shell is now zsh" notice in any bash started from here.
$env.BASH_SILENCE_DEPRECATION_WARNING = "1"
# WezTerm and tmux show 24-bit colour; without COLORTERM, bat and delta round
# every colour to the nearest of 256 (the theme's yellow turns orange).
if ($env.COLORTERM? | is-empty) { $env.COLORTERM = "truecolor" }
# jq output (and yazi's JSON previews, which use jq) in Neovim's colours:
# null/false/true, numbers, strings, arrays, objects, object keys.
$env.JQ_COLORS = "0;38;2;{{ cyan.rgb }}:0;38;2;{{ cyan.rgb }}:0;38;2;{{ cyan.rgb }}:0;38;2;{{ purple.rgb }}:0;38;2;{{ yellow.rgb }}:0;38;2;{{ fg.rgb }}:0;38;2;{{ fg.rgb }}:0;38;2;{{ cyan.rgb }}"
# $SHELL names the shell that is running, not just the login shell.
$env.SHELL = $nu.current-exe
$env.PAGER = "moor"
$env.MOOR = "--no-linenumbers --quit-if-one-screen"
$env.LESS = "-FRX"
if $nu.os-info.name != "windows" {
    $env.MANPAGER = "sh -c 'col -bx | bat --language=man --plain'"
    $env.MANROFFOPT = "-c"
}
$env.FZF_DEFAULT_OPTS = "--height=40% --layout=reverse --border --color=fg:{{ fg }},bg:{{ bg }},hl:{{ purple }},fg+:{{ fg }},bg+:{{ line }},hl+:{{ purple }},info:{{ yellow }},prompt:{{ green }},pointer:{{ red }},marker:{{ red }},spinner:{{ yellow }},header:{{ comment }}"
$env.BAT_THEME = "One Monokai Darker"
$env.EZA_CONFIG_DIR = ($nu.home-dir | path join ".config" "eza")
$env.FZF_DEFAULT_COMMAND = "fd --type f --hidden --follow --exclude .git"
