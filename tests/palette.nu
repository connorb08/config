use std/assert
use ../scripts/palette.nu render

let colours = {yellow: "#f1bd5b", cyan: "#32b8c9"}

# The three formats a template can ask for.
assert equal (render "a {{ yellow }} b" $colours) "a #f1bd5b b"
assert equal (render "{{yellow.bare}}" $colours) "f1bd5b"
assert equal (render "38;2;{{ yellow.rgb }}m" $colours) "38;2;241;189;91m"
# Vim fold markers and other braces are not placeholders.
assert equal (render "# Mode {{{" $colours) "# Mode {{{"
# An unknown colour is an error, not a silent blank.
assert (try { render "{{ orange }}" $colours; false } catch { true })

# End to end in a scratch repository.
let repo = (mktemp -d)
let generator = ($env.FILE_PWD | path join "../scripts/palette.nu")
def --wrapped run-generator [repo: path ...flags: string] {
    ^$nu.current-exe --no-config-file $generator $repo ...$flags | complete
}
try {
    mkdir ($repo | path join "templates" "dotfiles")
    '[colors]
yellow = "#f1bd5b"
cyan = "#32b8c9"
' | save ($repo | path join "palette.toml")
    "fg = \"{{ yellow }}\"\n" | save ($repo | path join "templates" "dotfiles" "tool.toml.tmpl")
    "<?xml version=\"1.0\"?>\n<c>{{ cyan }}</c>\n" | save ($repo | path join "templates" "dotfiles" "theme.xml.tmpl")
    let output = ($repo | path join "dotfiles" "tool.toml")

    assert equal (run-generator $repo).exit_code 0
    assert ((open --raw $output) | str contains 'fg = "#f1bd5b"')
    assert ((open --raw $output) | str starts-with "# Generated by scripts/palette.nu")
    # The header goes after an XML declaration, which must stay first.
    assert ((open --raw ($repo | path join "dotfiles" "theme.xml")) | str starts-with "<?xml")
    assert equal (run-generator $repo --check).exit_code 0

    # A palette change makes --check fail, and a run regenerates the output.
    open --raw ($repo | path join "palette.toml") | str replace "#f1bd5b" "#ffd866" | save --force ($repo | path join "palette.toml")
    assert ((run-generator $repo --check).exit_code != 0)
    assert equal (run-generator $repo).exit_code 0
    assert ((open --raw $output) | str contains 'fg = "#ffd866"')

    # An output edited by hand is reported and left alone, not overwritten.
    open --raw $output | str replace "fg =" "bg =" | save --force $output
    open --raw ($repo | path join "palette.toml") | str replace "#ffd866" "#f1bd5b" | save --force ($repo | path join "palette.toml")
    let result = (run-generator $repo)
    assert ($result.stderr | str contains "edited by hand")
    assert ((open --raw $output) | str contains 'bg = "#ffd866"')
} catch {|err|
    rm -r $repo
    error make $err
}
rm -r $repo

# The real repository: every generated file matches its template and palette.
let real = (^$nu.current-exe --no-config-file $generator ($env.FILE_PWD | path join "..") --check | complete)
assert equal $real.exit_code 0 $real.stderr
print "Palette rendering, regeneration, hand-edit protection and drift checks passed"
