# Render every template under templates/ with the colours in palette.toml.
#
#   nu scripts/palette.nu <repo>           write the outputs that changed
#   nu scripts/palette.nu <repo> --check   fail if any output is out of date
#
# templates/<path>.tmpl renders to <path> (for example
# templates/dotfiles/tmux/tmux.conf.tmpl -> dotfiles/tmux/tmux.conf), with a
# first-line comment saying so. palette.lock records what was last written to
# each output: an output edited by hand since then is left alone (and reported)
# rather than overwritten, so the edit can be moved into its template.

const placeholder = '\{\{\s*(?<name>[a-z][a-z0-9_]*)(?:\.(?<format>bare|rgb))?\s*\}\}'

def format-colour [hex: string, format: string] {
    let bare = ($hex | str replace '#' '')
    match $format {
        "bare" => $bare
        "rgb" => {
            [0 2 4] | each {|i| $bare | str substring $i..($i + 1) | into int --radix 16 | into string } | str join ";"
        }
        _ => $hex
    }
}

# A comment line naming the template, in the output's own comment syntax.
def header [output: string template: string] {
    let text = $"Generated by scripts/palette.nu from ($template) and palette.toml; edit those, not this file."
    match ($output | path parse | get extension) {
        "lua" => $"-- ($text)"
        "xml" => $"<!-- ($text) -->"
        _ => $"# ($text)"
    }
}

export def render [template: string colours: record --source: string = "template"] {
    let found = ($template | parse --regex $placeholder | uniq)
    let unknown = ($found | get name | uniq | where {|n| $n not-in ($colours | columns) })
    if ($unknown | is-not-empty) {
        error make { msg: $"($source): unknown colour ($unknown | str join ', '); add it to palette.toml" }
    }
    mut out = $template
    for token in ($template | parse --regex $"\(?<token>($placeholder)\)" | get token | uniq) {
        let parts = ($token | parse --regex $placeholder | first)
        let value = (format-colour ($colours | get $parts.name) ($parts.format? | default ""))
        $out = ($out | str replace --all $token $value)
    }
    $out
}

def with-header [content: string output: string template: string] {
    let line = (header $output $template)
    # An XML declaration has to stay first.
    if ($content | str starts-with "<?xml") {
        let rest = ($content | lines)
        ([($rest | first) $line] ++ ($rest | skip 1) | str join "\n") + "\n"
    } else {
        $"($line)\n($content)"
    }
}

def main [repo: path --check] {
    let repo = ($repo | path expand)
    let palette = (open ($repo | path join "palette.toml"))
    let colours = $palette.colors
    for row in ($colours | transpose name value) {
        if ($row.value !~ '^#[0-9a-f]{6}$') {
            error make { msg: $"palette.toml: ($row.name) = ($row.value) is not a lowercase #rrggbb colour" }
        }
    }
    let lock_path = ($repo | path join "palette.lock")
    let lock = (if ($lock_path | path exists) { open $lock_path } else { {} })
    let templates = (glob ($repo | path join "templates" "**" "*.tmpl") | sort)

    mut new_lock = {}
    mut changed = []
    mut stale = []
    mut hand_edited = []
    for template_path in $templates {
        let template = ($template_path | path relative-to $repo)
        let output = ($template | str replace --regex '^templates/' '' | str replace --regex '\.tmpl$' '')
        let output_path = ($repo | path join $output)
        let rendered = (with-header (render (open --raw $template_path) $colours --source $template) $output $template)
        let wanted = ($rendered | hash sha256)
        let current = (if ($output_path | path exists) { open --raw $output_path | hash sha256 } else { "" })
        let recorded = ($lock | get -o $output | default "")

        if $current == $wanted {
            $new_lock = ($new_lock | insert $output $wanted)
        } else if $check {
            $stale ++= [$output]
            $new_lock = ($new_lock | insert $output $recorded)
        } else if $current != "" and $recorded != "" and $current != $recorded {
            $hand_edited ++= [$output]
            $new_lock = ($new_lock | insert $output $recorded)
        } else {
            mkdir ($output_path | path dirname)
            $rendered | save --force --raw $output_path
            $changed ++= [$output]
            $new_lock = ($new_lock | insert $output $wanted)
        }
    }

    if $check {
        if ($stale | is-not-empty) {
            error make { msg: $"palette: out of date: ($stale | str join ', '). Run mise run palette." }
        }
        print "palette: every output is up to date"
        return
    }

    let lock_text = ($new_lock | sort | to json --indent 2) + "\n"
    if not ($lock_path | path exists) or (open --raw $lock_path) != $lock_text {
        $lock_text | save --force --raw $lock_path
    }
    for output in $hand_edited {
        print --stderr $"palette: ($output) was edited by hand since it was generated; left as is. Move the edit into templates/($output).tmpl, then delete ($output) and run this again."
    }
    if ($changed | is-empty) {
        print "palette: nothing to regenerate"
        return
    }
    print $"palette: regenerated ($changed | str join ', ')"

    # Tools that read a compiled copy or a running config.
    if ($changed | any {|f| $f ends-with "tmtheme.xml" }) and (which bat | is-not-empty) {
        ^bat cache --build | ignore
        print "palette: rebuilt bat's theme cache"
    }
    if ($changed | any {|f| $f ends-with "tmux.conf" }) and (which tmux | is-not-empty) {
        if (^tmux list-sessions | complete).exit_code == 0 {
            ^tmux source-file ($nu.home-dir | path join ".tmux.conf") | ignore
            print "palette: reloaded the running tmux"
        }
    }
}
