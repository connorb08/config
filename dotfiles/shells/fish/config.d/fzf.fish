if type -q fzf
    set -gx FZF_DEFAULT_OPTS '--height=40% --layout=reverse --border --color=fg:#abb2bf,bg:#12151a,hl:#b96aff,fg+:#abb2bf,bg+:#1c2128,hl+:#b96aff,info:#f9df6f,prompt:#8fd959,pointer:#ff5a67,marker:#ff5a67,spinner:#f9df6f,header:#636b78'
