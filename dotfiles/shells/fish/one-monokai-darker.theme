# One Monokai Darker, matching WezTerm and Starship.
fish_color_normal abb2bf
fish_color_command 8cc761
fish_color_keyword ff505e
fish_color_quote f1bd5b
fish_color_redirection da61fe
fish_color_end ff505e
fish_color_error ff505e
# Arguments in the theme's yellow (as in Nushell and zsh), not its orange (#e49346),
# which is for function parameters in code.
fish_color_param f1bd5b
fish_color_comment 676f7d
fish_color_operator ff505e
fish_color_escape da61fe
fish_color_autosuggestion 676f7d
fish_color_selection d7dae0 --background=2c3340
fish_color_search_match abb2bf --background=344566
fish_color_valid_path --underline
fish_color_cancel ff505e --reverse
fish_color_history_current --bold
fish_pager_color_progress 676f7d
fish_pager_color_prefix 32b8c9 --bold
fish_pager_color_completion abb2bf
fish_pager_color_description 676f7d
fish_pager_color_selected_background --background=2c3340
